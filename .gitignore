# 环境变量
.env

# 前端依赖与构建缓存
node_modules/
dist/

# unplugin 自动生成的类型声明（构建时自动重新生成）
frontend/src/auto-imports.d.ts
frontend/src/components.d.ts

# 后端构建产物
target/

# Markdown 正文文件（数据，不进入 git；只忽略仓库根目录，避免误伤 java 包路径）
/markdown/

# 图片上传文件（数据，不进入 git；只忽略仓库根目录）
/uploads/

# 日志
*.log

# IDE
.idea/
.vscode/

# 系统
.DS_Store
Thumbs.db

# vite 构建临时文件
vite.config.ts.timestamp-*
