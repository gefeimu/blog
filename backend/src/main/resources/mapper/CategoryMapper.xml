<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.blog.mapper.CategoryMapper">

    <resultMap id="categoryMap" type="com.blog.entity.Category">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="sort" property="sort"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <select id="selectAll" resultMap="categoryMap">
        SELECT id, name, sort, created_at
        FROM category
        ORDER BY sort
    </select>

    <select id="selectById" resultMap="categoryMap">
        SELECT id, name, sort, created_at
        FROM category
        WHERE id = #{id}
    </select>

</mapper>
