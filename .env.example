# 复制为 .env 后按需修改（.env 不入库）
# 首次部署：scp 到服务器 /opt/blog/.env

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=blog
MYSQL_USER=blog
MYSQL_PASSWORD=change-me-blog

# JWT 签名密钥（≥32位随机串，登录态安全的基础）
# 生成示例：openssl rand -base64 48
BLOG_JWT_SECRET=change-me-32-char-random-secret

# 首次启动自动创建的管理员密码
BLOG_ADMIN_PASSWORD=change-me-admin

# Waline 评论系统
# JWT 加密密钥（生成示例：openssl rand -hex 32）
WALINE_JWT_TOKEN=change-me-64-hex-random-token
# 站点名称（邮件通知与后台显示）
WALINE_SITE_NAME=我的博客
# 站点地址（邮件通知里的文章链接）
WALINE_SITE_URL=http://your-server-ip
# 管理员邮箱（新评论邮件通知，不配则不发送）
WALINE_AUTHOR_EMAIL=mail@example.com
